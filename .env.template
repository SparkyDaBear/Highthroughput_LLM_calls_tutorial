# Environment Variables Template
# 
# HOW TO USE THIS FILE:
# 1. Copy this file to a new file named .env
# 2. Replace the empty quotes with your actual API keys
# 3. In terminal: source .env
# 4. Verify keys loaded: echo $OPENAI_API_KEY
#
# IMPORTANT SECURITY NOTES:
# - Never commit this .env file to Git
# - The .gitignore file will prevent accidents, but be careful
# - Never share your API keys with anyone
# - Consider rotating keys periodically
# - Delete old keys from API dashboards after rotating

# ============================================================
# OPENAI API KEY
# ============================================================
# Get your key from: https://platform.openai.com/account/api-keys
# 
# Steps:
# 1. Sign up at https://platform.openai.com
# 2. Go to Account → API Keys
# 3. Click "Create new secret key"
# 4. Copy the key (you'll only see it once!)
# 5. Paste it below between the quotes
#
# Your key should look like: sk-proj-... (long alphanumeric string)
#
export OPENAI_API_KEY=""

# ============================================================
# OPENROUTER API KEY  
# ============================================================
# Get your key from: https://openrouter.ai/keys
#
# Steps:
# 1. Sign up at https://openrouter.ai
# 2. Go to Keys section
# 3. Click to generate a new key
# 4. Copy the key
# 5. Paste it below between the quotes
#
# Your key should look like: sk-or-... (long alphanumeric string)
#
export OPENROUTER_API_KEY=""

